# Free speech-to-text key from https://console.groq.com/keys (no card needed).
GROQ_API_KEY=

# Free voice (Kokoro): a calm British male. Other choices: bm_daniel, bm_fable, bm_lewis, or the old
# American female af_heart.
VOICE=bm_george

# Microphone: part of its name, such as WebCamera, when the Windows default input is not the mic you talk
# into. Empty: the Windows default.
MIC_DEVICE=
# A second mic for when that one won't open, or sends pure silence for 30 seconds (a virtual mic whose app closed).
# Part of its name, such as Realtek. It stays on this one until the mic is turned off and on, or the boss restarts.
MIC_FALLBACK=
# Wakes on you, then says nothing or cuts you off from across the room? A quiet mic is below what end-of-speech
# detection hears. Try 16; lower it if recordings run on after you stop. Empty: 1.
VAD_BOOST=
# After each spoken reply it keeps listening this many seconds for an answer without the wake word (8 by
# default, 0 turns it off).
FOLLOWUP_SECONDS=
# In a call (another app is on the mic) it only says "I have an update". Apps that hold the mic all day don't
# count: part of each name, comma separated (voicemod by default).
CALL_IGNORE=
# The on-screen caption and the window stay out of screen shares and recordings. 1 shows them there too.
CAPTION_VISIBLE=
# off: don't open the window (README, "Window"), even when it is installed.
VOICE_WINDOW=
# How it addresses you: every spoken line opens with this word, such as Sir ("Sir, the course session
# needs you."). Empty: no title.
VOICE_TITLE=
# Wake word sensitivity, 0.5 by default. Lower (0.3 or 0.4) if it misses you, higher if it wakes on its own.
WAKE_THRESHOLD=

# Pro voice (optional, paid): ElevenLabs hears you and speaks in your own cloned voice or a stock one.
# Set VOICE_ENGINE=elevenlabs (or start with start.ps1 -Engine elevenlabs). See "Pro voice" in README.md.
VOICE_ENGINE=
ELEVENLABS_API_KEY=
# Empty: the stock British voice George. Or your clone's voice ID, or any voice from the Voice Library,
# such as the butler-style Rupert: 89gcX1AeMGgcsN8ypHLu
ELEVENLABS_VOICE_ID=
# Empty: eleven_flash_v2_5 (fastest, cheapest). eleven_v4_turbo sounds more natural.
ELEVENLABS_MODEL=

# Faster answers (optional): with a TypeSafe key, Jev sorts what you say, and the status of your sessions,
# small talk and unclear speech are answered in about a second, without a turn of the boss. Small talk also
# needs an Anthropic API key (Claude Haiku). Any key here can instead be NAME_FILE=path to a file holding it.
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
