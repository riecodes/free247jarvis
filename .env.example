# Free speech-to-text key from https://console.groq.com/keys (no card needed).
GROQ_API_KEY=

# Free voice (Kokoro): a calm British male. Other choices: bm_daniel, bm_fable, bm_lewis, or the old
# American female af_heart.
VOICE=bm_george

# Microphone: part of its name, such as WebCamera, when the Windows default input is not the mic you talk
# into. Empty: the Windows default.
MIC_DEVICE=
# A second mic for when that one won't open, or sends pure silence for 30 seconds (a virtual mic whose app closed).
# Part of its name, such as Realtek. It stays on this one until the mic is turned off and on, or the boss restarts.
MIC_FALLBACK=
# Wakes on you, then says nothing or cuts you off from across the room? A quiet mic is below what end-of-speech
# detection hears. Try 16; lower it if recordings run on after you stop. Empty: 1.
VAD_BOOST=
# After each spoken reply it keeps listening this many seconds for an answer without the wake word (8 by
# default, 0 turns it off).
FOLLOWUP_SECONDS=
# asked: keep listening only after a line that asks you something. By default it's after everything it says.
LISTEN_AFTER=
# In a call (another app is on the mic) it only says "I have an update". Apps that hold the mic all day don't
# count: part of each name, comma separated (voicemod by default).
CALL_IGNORE=
# The window stays out of screen shares and recordings. 1 shows it there too. Windows notifications always show.
CAPTION_VISIBLE=
# off: don't open the window (README, "Window"), even when it is installed.
VOICE_WINDOW=
# How it addresses you: every spoken line opens with this word, such as Sir ("Sir, the course session
# needs you."). Empty: no title.
VOICE_TITLE=
# Two PCs that sync a folder: that folder, on both, so only one has the voice (README, "Good to know").
VOICE_SHARED=
# These switches are also in the window's Settings, which save them here. off: a chime on waking, not a few spoken words.
GREETING=
# off: no chimes for listening, heard and done.
SOUNDS=
# off: nothing that waits on you follows a greeting.
REMINDERS=
# off: says nothing after its ears stop or a request is lost.
CUT_OFF=
# off: talking over a reply doesn't stop it, only "Hey Jarvis" does.
TALK_OVER=
# How much louder than a reply's echo your voice must be to stop it, 2 by default. Higher if the speaker stops itself;
# lower if it won't stop for you. "Over that reply" in tmp/voice.log shows what each reply measured.
TALK_OVER_RATIO=
# Seconds before the end of a reply that it listens again, 0.5 by default. 0: at its last word. Lower it if the speaker sets it off.
LISTEN_LEAD=
# Ending a request with "do it", "go ahead", "thank you" and the like sends it after this many seconds of quiet, 0.8 by
# default, instead of 5. CLOSING_CUT=off leaves it all to the silence. README, "Good to know".
CLOSING_GAP=
CLOSING_CUT=
# Wake word sensitivity, 0.5 by default. Lower (0.3 or 0.4) if it misses you, higher if it wakes on its own.
WAKE_THRESHOLD=
# off: wake on the score alone, without speech to text also hearing "Jarvis" first (README, "Good to know"). A bare
# "hey" can wake it then.
WAKE_NAME=
# off: two claps don't wake it. CLAP_LEVEL: how loud a clap must peak, 2000 by default (int16); lower it if it misses
# your claps, raise it if it wakes on its own (README, "Good to know").
CLAP=
CLAP_LEVEL=
# While you seem to be with someone (README, "Good to know"): the wake word score it needs then, 0.7 by default, and
# the share of the last 30 s that must be speech to count as people talking, 0.4 by default.
WAKE_STRICT=
TALK_SHARE=
# Optional, off unless you choose it (README, "Voice data"): on keeps the audio and words of each request that passed or try it ignored at
# the wake word in %LOCALAPPDATA%\free247jarvis\voicedata, on this PC only, for 30 days or 2 GB. forever: no limit.
# Anyone near the mic is in those clips. Empty or off: no clips or their rows are kept. tmp\voice.log still holds the
# words as text, whatever this says.
VOICE_DATA=
# off: keep none of the last 50 things heard (in %LOCALAPPDATA%\free247jarvis\recent, for POST /resend-last).
RECENT=

# Pro voice (optional, paid): ElevenLabs hears you and speaks in your own cloned voice or a stock one.
# Set VOICE_ENGINE=elevenlabs (or start with start.ps1 -Engine elevenlabs). See "Pro voice" in README.md.
VOICE_ENGINE=
# kokoro: with the pro voice, ElevenLabs hears (Scribe, live words) and the free voice speaks.
VOICE_TTS=
ELEVENLABS_API_KEY=
# Empty: the stock British voice George. Or your clone's voice ID, or any voice from the Voice Library,
# such as the butler-style Rupert: 89gcX1AeMGgcsN8ypHLu
ELEVENLABS_VOICE_ID=
# Empty: eleven_flash_v2_5 (fastest, cheapest). eleven_v4_turbo sounds more natural.
ELEVENLABS_MODEL=

# Faster answers (optional): with a TypeSafe key, Jev sorts what you say, and the status of your sessions,
# small talk and unclear speech are answered in about a second, without a turn of the boss. Small talk also
# needs an Anthropic API key (Claude Haiku). Any key here can instead be NAME_FILE=path to a file holding it.
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=

# Near real-time prototype (paid; README, "Near real-time"): realtime.py here, and OpenAI's key.
VOICE_LISTENER=
OPENAI_API_KEY=

# Knowledge (optional, also needs both keys above): questions your notes answer are answered in about a second.
# Folders of short .md notes separated by ;. All notes go to Anthropic with each such question, or past 8,000
# characters those that share words with it.
KNOWLEDGE_DIR=
# A URL of live values as flat JSON strings, for {placeholders} in the notes, such as {price}.
KNOWLEDGE_FACTS=
